"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000042","line":42,"sourceId":"0094:000042","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「……はにょー」","english":"“...Hanyoo.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000047","line":47,"sourceId":"0094:000047","speakerJa":"","speakerEn":"","japanese":"　あずさはそんな無意味な声を漏らすと、立ち上が\nり、闇に消えた。","english":"Azusa made that meaningless sound, got up, and disappeared into the dark.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000049","line":49,"sourceId":"0094:000049","speakerJa":"章二","speakerEn":"Shouji","japanese":"「……」","english":"“...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000050","line":50,"sourceId":"0094:000050","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「……」","english":"“...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000052","line":52,"sourceId":"0094:000052","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「……」","english":"“...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000056","line":56,"sourceId":"0094:000056","speakerJa":"","speakerEn":"","japanese":"　青ざめた顔で戻ってきた。","english":"She returned, pale-faced.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000059","line":59,"sourceId":"0094:000059","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「はわわわわ……！」","english":"“H-h-h-hwaaa...!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000060","line":60,"sourceId":"0094:000060","speakerJa":"","speakerEn":"","japanese":"　泣いていた。","english":"She was crying.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000061","line":61,"sourceId":"0094:000061","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「どうしたの！」","english":"“What's wrong!?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000064","line":64,"sourceId":"0094:000064","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「死ぬー……もう死ぬー……\n　スイッチ切れるー……」","english":"“I'm gonna die... I'm gonna die now... My switch is gonna turn off...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000066","line":66,"sourceId":"0094:000066","speakerJa":"章二","speakerEn":"Shouji","japanese":"「……またぞろくだらん勘違いなんだろうが、タイ\n　ミングがタイミングだけに厄介な予感がするな」","english":"“...It's probably just another stupid misunderstanding. But given the timing, I've got a bad feeling about it.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000067","line":67,"sourceId":"0094:000067","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「あずさ、どうしたの？」","english":"“Azusa, what happened?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000069","line":69,"sourceId":"0094:000069","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「死にたくないよぉ」","english":"“I don't wanna die!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000071","line":71,"sourceId":"0094:000071","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「あずさ、どうしたの？　ちゃんと話して」","english":"“Azusa, what's wrong? Tell us what's going on.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000073","line":73,"sourceId":"0094:000073","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「人間は血と肉の袋だから死ぬんだ！」","english":"“Humans die because they're just bags of blood and meat!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000078","line":78,"sourceId":"0094:000078","speakerJa":"","speakerEn":"","japanese":"　わっと泣き伏せた。","english":"She collapsed in a heap, sobbing.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000079","line":79,"sourceId":"0094:000079","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「なにかあったの？」","english":"“Did something happen?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000082","line":82,"sourceId":"0094:000082","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「忍くーん！」","english":"“Shinobuuu!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000088","line":88,"sourceId":"0094:000088","speakerJa":"","speakerEn":"","japanese":"　抱きつく。","english":"She flung her arms around him.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000091","line":91,"sourceId":"0094:000091","speakerJa":"章二","speakerEn":"Shouji","japanese":"「……オレ、メシクテクル」","english":"“...I'M GONNA GET FOOD.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000092","line":92,"sourceId":"0094:000092","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「何いってんだてめぇ」","english":"“The hell are you talking about?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000093","line":93,"sourceId":"0094:000093","speakerJa":"","speakerEn":"","japanese":"　口が悪くなった。","english":"His tone had turned rough.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000096","line":96,"sourceId":"0094:000096","speakerJa":"章二","speakerEn":"Shouji","japanese":"「違う！　気付け！\n　オレが一番空気読めてんだ！」","english":"“No! Take the hint! I’m reading the room better than anyone here!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000100","line":100,"sourceId":"0094:000100","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「……！」","english":"“...!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000101","line":101,"sourceId":"0094:000101","speakerJa":"","speakerEn":"","japanese":"　沙也加が気付く。","english":"Sayaka caught on.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000103","line":103,"sourceId":"0094:000103","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「ああ、そういうこと……」","english":"“Oh, so that's it...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000104","line":104,"sourceId":"0094:000104","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「ん？」","english":"“Hm?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000106","line":106,"sourceId":"0094:000106","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「行ってちょうだい」","english":"“Go on, please.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000108","line":108,"sourceId":"0094:000108","speakerJa":"章二","speakerEn":"Shouji","japanese":"「おまえも来い」","english":"“You're coming too.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000109","line":109,"sourceId":"0094:000109","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「なんで？」","english":"“Why?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000114","line":114,"sourceId":"0094:000114","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「いっちゃやだー！」","english":"“Don't go!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000119","line":119,"sourceId":"0094:000119","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「いいのよ、あずさ。いいの」","english":"“It's all right, Azusa. It's all right.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000120","line":120,"sourceId":"0094:000120","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「って言うけど……」","english":"“You say that, but...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000123","line":123,"sourceId":"0094:000123","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「…………あのね」","english":"“............You see...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000124","line":124,"sourceId":"0094:000124","speakerJa":"","speakerEn":"","japanese":"　耳打ちしようとする。\n　あずさの絶叫が遮る。","english":"She leaned over to whisper in his ear. Azusa's shriek drowned her out.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000127","line":127,"sourceId":"0094:000127","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「鮮血の徒花が咲き誇るよー！！」","english":"“A fruitless flower of fresh blood is blooming in all its glory!!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000128","line":128,"sourceId":"0094:000128","speakerJa":"","speakerEn":"","japanese":"　意味は不明だ。","english":"The meaning was unclear.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000129","line":129,"sourceId":"0094:000129","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「……あ、あずさ、それって……」","english":"“...A-Azusa, do you mean...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000132","line":132,"sourceId":"0094:000132","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「ちがでたー！」","english":"“I'm bleeding!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000135","line":135,"sourceId":"0094:000135","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「あずさ」","english":"“Azusa.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000139","line":139,"sourceId":"0094:000139","speakerJa":"","speakerEn":"","japanese":"　ポーチを手にした沙也加が、あずさの手をひっ掴\nんで連れて行った。","english":"Pouch in hand, Sayaka seized Azusa by the wrist and led her away.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000140","line":140,"sourceId":"0094:000140","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「あの……！」","english":"“Um...!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000142","line":142,"sourceId":"0094:000142","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「しばらく出かけてきて」","english":"“Go out for a while.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000143","line":143,"sourceId":"0094:000143","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「は、はい！」","english":"“Y-yes!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000147","line":147,"sourceId":"0094:000147","speakerJa":"","speakerEn":"","japanese":"　静寂。","english":"Silence.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000148","line":148,"sourceId":"0094:000148","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「…………」","english":"“............”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000150","line":150,"sourceId":"0094:000150","speakerJa":"章二","speakerEn":"Shouji","japanese":"「だから言っただろうが……」","english":"“I tried to tell you...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000152","line":152,"sourceId":"0094:000152","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「……ごめん」","english":"“...Sorry.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000154","line":154,"sourceId":"0094:000154","speakerJa":"章二","speakerEn":"Shouji","japanese":"「ぶらついてこようぜ」","english":"“Let's go kill some time.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000155","line":155,"sourceId":"0094:000155","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「…………うん」","english":"“............Okay.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000164","line":164,"sourceId":"0094:000164","speakerJa":"","speakerEn":"","japanese":"　一時間ほどして戻る。\n　そっと工場をのぞく。","english":"They returned about an hour later. They cautiously peeked into the factory.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000165","line":165,"sourceId":"0094:000165","speakerJa":"章二","speakerEn":"Shouji","japanese":"「どうだ？」","english":"“Well?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000166","line":166,"sourceId":"0094:000166","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「……話してる」","english":"“...They're talking.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000167","line":167,"sourceId":"0094:000167","speakerJa":"章二","speakerEn":"Shouji","japanese":"「頭下げてくれ。オレ様にも見せろ」","english":"“Keep your head down. Let me have a look.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000168","line":168,"sourceId":"0094:000168","speakerJa":"","speakerEn":"","japanese":"　薄闇の中、猫背になったあずさと、隣に座って何\n事か言い聞かせている沙也加がいた。","english":"In the dim light, Azusa sat hunched over, with Sayaka beside her, talking her through something.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000174","line":174,"sourceId":"0094:000174","speakerJa":"章二","speakerEn":"Shouji","japanese":"「……まだ途中か」","english":"“...Still not done?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000175","line":175,"sourceId":"0094:000175","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「まさか……」","english":"“I can't believe it...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000177","line":177,"sourceId":"0094:000177","speakerJa":"章二","speakerEn":"Shouji","japanese":"「ん？」","english":"“Hm?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000178","line":178,"sourceId":"0094:000178","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「まさかあずさにアレが……来るだなんて……」","english":"“I can't believe Azusa actually... got it...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000180","line":180,"sourceId":"0094:000180","speakerJa":"章二","speakerEn":"Shouji","japanese":"「おまえ混乱してるぞ、たぶん」","english":"“You’re probably not thinking straight.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000181","line":181,"sourceId":"0094:000181","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「ずっと来ないと思ってたのに……」","english":"“I thought it never would...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000183","line":183,"sourceId":"0094:000183","speakerJa":"章二","speakerEn":"Shouji","japanese":"「遅いくらいだ」","english":"“If anything, she's late.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000184","line":184,"sourceId":"0094:000184","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「どうしよう……」","english":"“What do I do...?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000186","line":186,"sourceId":"0094:000186","speakerJa":"章二","speakerEn":"Shouji","japanese":"「とりあえず落ち着け」","english":"“Just calm down for now.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000187","line":187,"sourceId":"0094:000187","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「はああぁううぅぅぅ……」","english":"“Haaauuugh...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000189","line":189,"sourceId":"0094:000189","speakerJa":"章二","speakerEn":"Shouji","japanese":"「…………コイツは……」","english":"“............This idiot...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000191","line":191,"sourceId":"0094:000191","speakerJa":"章二","speakerEn":"Shouji","japanese":"「今日はもう引き上げるぞ」","english":"“We're done for today.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000196","line":196,"sourceId":"0094:000196","speakerJa":"","speakerEn":"","japanese":"　忍の衿を掴んで引っ張っていく。","english":"He grabbed Shinobu by the collar and dragged him away.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000198","line":198,"sourceId":"0094:000198","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「……あああぁ」","english":"“...Aaaah...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000199","line":199,"sourceId":"0094:000199","speakerJa":"章二","speakerEn":"Shouji","japanese":"「優柔不断な父親か貴様は！」","english":"“What are you, her indecisive father!?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000200","line":200,"sourceId":"0094:000200","speakerJa":"","speakerEn":"","japanese":"　それはそれとして。","english":"That aside—","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000205","line":205,"sourceId":"0094:000205","speakerJa":"","speakerEn":"","japanese":"　二人が目にした、落ち込むあずさに語りかける\n沙也加の姿。","english":"What they had seen was Sayaka speaking to a dejected Azusa.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000207","line":207,"sourceId":"0094:000207","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「―――」","english":"“—”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000208","line":208,"sourceId":"0094:000208","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「―――」","english":"“—”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000209","line":209,"sourceId":"0094:000209","speakerJa":"","speakerEn":"","japanese":"　彼女は……あずさには優しい。\n　忍にそうするように、優しい。","english":"She was... kind to Azusa. As kind as she was to Shinobu.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000210","line":210,"sourceId":"0094:000210","speakerJa":"","speakerEn":"","japanese":"　どこか―――","english":"Somehow—","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000216","line":216,"sourceId":"0094:000216","speakerJa":"","speakerEn":"","japanese":"　そしてこの日から、あずさにも少しだけ、少女と\nしての秘めた部分が生まれた。","english":"And from that day on, Azusa, too, had a little secret of her own as a girl.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000222","line":222,"sourceId":"0094:000222","speakerJa":"","speakerEn":"","japanese":"　あくる日。\n　温泉饅頭を食べて談笑しているときだった。","english":"The following day. They were chatting over hot-spring buns.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000224","line":224,"sourceId":"0094:000224","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「……む」","english":"“...Mm.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000225","line":225,"sourceId":"0094:000225","speakerJa":"","speakerEn":"","japanese":"　下腹部を押さえて、あずさが短く呻いた。","english":"Azusa pressed a hand to her lower belly and gave a short groan.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000226","line":226,"sourceId":"0094:000226","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「……どうしたの？」","english":"“...What's wrong?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000229","line":229,"sourceId":"0094:000229","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「……来たな」","english":"“...It's here.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000231","line":231,"sourceId":"0094:000231","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「……！」","english":"“...!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000233","line":233,"sourceId":"0094:000233","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「来た？」","english":"“What's here?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000235","line":235,"sourceId":"0094:000235","speakerJa":"葉子","speakerEn":"Youko","japanese":"「……………………」","english":"“................................”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000239","line":239,"sourceId":"0094:000239","speakerJa":"","speakerEn":"","japanese":"　葉子が妙に据わった視線をあずさに向けていた。","english":"Youko fixed Azusa with an oddly unblinking stare.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000243","line":243,"sourceId":"0094:000243","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「……開戦」","english":"“...The war begins.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000246","line":246,"sourceId":"0094:000246","speakerJa":"","speakerEn":"","japanese":"　すっくと立ち上がる。","english":"She sprang to her feet.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000248","line":248,"sourceId":"0094:000248","speakerJa":"章二","speakerEn":"Shouji","japanese":"「やるからには勝ってみせろ」","english":"“If you're going to fight, make sure you win.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000250","line":250,"sourceId":"0094:000250","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「当然だよこのやろう」","english":"“You bet your ass I will!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000251","line":251,"sourceId":"0094:000251","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「一緒に行こうか？　行こうか？」","english":"“Want me to come with you? Want me to?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000254","line":254,"sourceId":"0094:000254","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「よしなさい」","english":"“Stop that.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000259","line":259,"sourceId":"0094:000259","speakerJa":"斎","speakerEn":"Itsuki","japanese":"「？」","english":"“?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000261","line":261,"sourceId":"0094:000261","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「一体どうしたの？　示し合わせたみたいに……」","english":"“What on earth is going on? It's as though you all planned this...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000263","line":263,"sourceId":"0094:000263","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「ちょっと行ってくるから！　なに、勝てるさ！\n　たたかいは出会い頭でキマリだ！」","english":"“I'm heading out for a bit! Don't worry, I can win! The first clash decides the battle!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000265","line":265,"sourceId":"0094:000265","speakerJa":"","speakerEn":"","japanese":"　決意の瞳を向けた。","english":"She gave them a look of fierce determination.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000267","line":267,"sourceId":"0094:000267","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「え、ええ……そう……頑張って……」","english":"“R-right... I see... Good luck...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000271","line":271,"sourceId":"0094:000271","speakerJa":"","speakerEn":"","japanese":"　メガネ曇ってた。\n　戸惑いすぎて思考力が低下するとこうなるのだ。","english":"Her glasses had fogged over. That was what happened when confusion overwhelmed her ability to think.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000274","line":274,"sourceId":"0094:000274","speakerJa":"","speakerEn":"","japanese":"　そしてあずさはおもむろにポケットに手を突っ込\nむと、ごそごそと中身をさぐった。","english":"Azusa then slipped a hand into her pocket and rummaged around inside.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000277","line":277,"sourceId":"0094:000277","speakerJa":"","speakerEn":"","japanese":"　ビー玉やいつのものかわからない駄菓子屋のサービ\nス券やローメンコやメカ生体のポリキャップや四駆模\n型のパーツやらがこぼれ落ちたが、お目当ての品は","english":"Marbles, a candy-store coupon from who knew when, wax menko disks, Zoids polycaps, and parts from a four-wheel-drive model car spilled out. Apparently, though, what she wanted...","hyperlinks":[{"start":50,"end":65,"targetRef":"saihate:hyperlinks:0084:000016","preview":"Anyone who has never heard of wax menko disks is a rank amateur."}],"japaneseHyperlinks":[{"start":28,"end":33,"targetRef":"saihate:hyperlinks:0084:000016","preview":"Anyone who has never heard of wax menko disks is a rank amateur."}]},{"ref":"saihate:hyperlinks:0094:000279","line":279,"sourceId":"0094:000279","speakerJa":"","speakerEn":"","japanese":"それらではないようだった。","english":"was none of those things.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000282","line":282,"sourceId":"0094:000282","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「あれ、どこだっけな？」","english":"“Huh? Where did I put it?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000285","line":285,"sourceId":"0094:000285","speakerJa":"","speakerEn":"","japanese":"　全てのポケットをひっくり返して探す。","english":"She turned every pocket inside out in her search.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000286","line":286,"sourceId":"0094:000286","speakerJa":"","speakerEn":"","japanese":"　スーパーボールやらクッキーやら銀紙に包まれた\nチョコスティックやら小梅さん（飴）やら王冠やら","english":"A bouncy ball, a cookie, a chocolate stick wrapped in foil, a Koume candy, a bottle cap...","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000287","line":287,"sourceId":"0094:000287","speakerJa":"","speakerEn":"","japanese":"アクセサリーサイズの武器（メリケンやヌンチャク\n類）やら三センチくらいの十徳ナイフやら。","english":"Accessory-sized weapons—brass knuckles and nunchaku— and a tiny multi-tool about three centimeters long.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000290","line":290,"sourceId":"0094:000290","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「あ、あった」","english":"“Oh, found it.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000293","line":293,"sourceId":"0094:000293","speakerJa":"","speakerEn":"","japanese":"　ようやく見つけ出したそれ……超フィット感があ\nり横漏れガードがついた多い日も安心な一品を、\n一同に向けて誇らしげに誇らしげに突きつけた。","english":"At last she found it... an item promising an ultra-snug fit, side-leak guards, and peace of mind even on heavy days. Proudly—proudly—she thrust it out for everyone to see.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000295","line":295,"sourceId":"0094:000295","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「では！」","english":"“Well then!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000297","line":297,"sourceId":"0094:000297","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「―――」","english":"“—”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000301","line":301,"sourceId":"0094:000301","speakerJa":"","speakerEn":"","japanese":"　沙也加はあずさの鼻を華麗にねじりあげた。","english":"With elegant precision, Sayaka seized Azusa's nose and twisted it.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000304","line":304,"sourceId":"0094:000304","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「いだだだだだだだだだだ！！」","english":"“Ow-ow-ow-ow-ow-ow-ow-ow!!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000307","line":307,"sourceId":"0094:000307","speakerJa":"","speakerEn":"","japanese":"　少女として、もっと秘めなければならないようだ。","english":"Apparently, she still had more to learn about what a girl should keep private.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000313","line":313,"sourceId":"0094:000313","speakerJa":"","speakerEn":"","japanese":"　なんでもポケットじか入れ、というあずさの習性\nが問題視され、有志でお金を出し合ってポーチを買\nい与えることになった。","english":"Azusa's habit of carrying absolutely everything loose in her pockets was deemed a problem. A collection was taken up to buy her a pouch.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000314","line":314,"sourceId":"0094:000314","speakerJa":"","speakerEn":"","japanese":"　少年の日の夢と多い日の安心は決して相容れぬも\nのなのである。","english":"The dreams of boyhood and peace of mind on heavy days could never coexist.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000315","line":315,"sourceId":"0094:000315","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「僕も出すよ」","english":"“I'll contribute too.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000317","line":317,"sourceId":"0094:000317","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「……いいわよ」","english":"“...No need.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000318","line":318,"sourceId":"0094:000318","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「でも」","english":"“But—”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000320","line":320,"sourceId":"0094:000320","speakerJa":"葉子","speakerEn":"Youko","japanese":"「だめな保護者です」","english":"“Some guardian you are.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000322","line":322,"sourceId":"0094:000322","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「……うう……」","english":"“...Ugh...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000326","line":326,"sourceId":"0094:000326","speakerJa":"","speakerEn":"","japanese":"　有志は女子だけで構成された。\n　男は追い払われた。","english":"Only the girls volunteered. The guys were driven out.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000328","line":328,"sourceId":"0094:000328","speakerJa":"章二","speakerEn":"Shouji","japanese":"「メシクテクル」","english":"“I'M GONNA GET FOOD.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000330","line":330,"sourceId":"0094:000330","speakerJa":"","speakerEn":"","japanese":"　章二は、とばっちりを食わないようさっさと逃げ\n出した。","english":"Shouji fled at once to avoid becoming collateral damage.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000332","line":332,"sourceId":"0094:000332","speakerJa":"","speakerEn":"","japanese":"　斎ははっきり言って、いてもいなくてもわからない。","english":"Frankly, it was impossible to tell whether Itsuki was there or not.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000333","line":333,"sourceId":"0094:000333","speakerJa":"","speakerEn":"","japanese":"　そもそも口出ししてこない。\n　印象からは意外なことではあるが、斎は存外野暮\nではない。","english":"He never tried to butt in. Contrary to appearances, Itsuki was surprisingly tactful.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000335","line":335,"sourceId":"0094:000335","speakerJa":"","speakerEn":"","japanese":"　空気の読めない人間は忍一人であった。","english":"Shinobu was the only one who could not read the room.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000336","line":336,"sourceId":"0094:000336","speakerJa":"忍","speakerEn":"Shinobu","japanese":"「……んー」","english":"“...Hmm.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000338","line":338,"sourceId":"0094:000338","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「いいから」","english":"“Just...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000340","line":340,"sourceId":"0094:000340","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「さっさと」","english":"“Hurry up...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000342","line":342,"sourceId":"0094:000342","speakerJa":"葉子","speakerEn":"Youko","japanese":"「出てってください」","english":"“And leave, please.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000346","line":346,"sourceId":"0094:000346","speakerJa":"","speakerEn":"","japanese":"　追い出された。","english":"He was thrown out.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000351","line":351,"sourceId":"0094:000351","speakerJa":"","speakerEn":"","japanese":"　そのようなことがあって、あずさにポーチが贈呈\nされた。","english":"After all that, Azusa was presented with a pouch.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000353","line":353,"sourceId":"0094:000353","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「……ありがとー」","english":"“...Thaaanks.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000355","line":355,"sourceId":"0094:000355","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「次からはそれ使うのよ、おチビ」","english":"“Use it from now on, short stuff.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000357","line":357,"sourceId":"0094:000357","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「うん、がんばる」","english":"“Okay. I'll try.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000359","line":359,"sourceId":"0094:000359","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「無造作にポケットに入れてたらダメよ」","english":"“You mustn't simply stuff them loose into your pockets.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000361","line":361,"sourceId":"0094:000361","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「うん、気をつける」","english":"“Okay. I'll be careful.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000363","line":363,"sourceId":"0094:000363","speakerJa":"葉子","speakerEn":"Youko","japanese":"「布巾ではなく棒の方にすれば、筆入れに入れて\n　カモフラージュできますけど」","english":"“If you use the stick instead of the cloth, you can hide it in your pencil case.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000366","line":366,"sourceId":"0094:000366","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「　無　理　よ　！　」","english":"“ABSOLUTELY NOT!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000369","line":369,"sourceId":"0094:000369","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「いいねそれ」","english":"“Good idea.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000372","line":372,"sourceId":"0094:000372","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「　信　じ　る　な　！　！　」","english":"“DO NOT BELIEVE HER!!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000375","line":375,"sourceId":"0094:000375","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「……いったいどうやったら、\n　そんなことを思いつけるの？」","english":"“...How in the world do you come up with things like that?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000377","line":377,"sourceId":"0094:000377","speakerJa":"葉子","speakerEn":"Youko","japanese":"「気分次第で、自然に湧いてくるんスよ」","english":"“Depends on my mood. Stuff like that just comes to me.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000379","line":379,"sourceId":"0094:000379","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「でも棒は怖いなぁ……」","english":"“The stick sounds scary, though...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000381","line":381,"sourceId":"0094:000381","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「布巾の方でいいのよ」","english":"“The cloth kind will do.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000383","line":383,"sourceId":"0094:000383","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「……学校ではじまったらどうするんだろ……」","english":"“...What do I do if it starts at school...?”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000385","line":385,"sourceId":"0094:000385","speakerJa":"葉子","speakerEn":"Youko","japanese":"「うまくやりくり」","english":"“Make do.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000387","line":387,"sourceId":"0094:000387","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「体調やサイクルをよく把握して、\n　警戒しておく……くらいしかないわね」","english":"“Pay close attention to how you're feeling and to your cycle, and be prepared... That's about all you can do.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000389","line":389,"sourceId":"0094:000389","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「長い戦いよ。頑張れ」","english":"“It's a long war. Good luck.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000391","line":391,"sourceId":"0094:000391","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「うん、がんばって倒すよ」","english":"“Okay. I'll do my best to beat it.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000393","line":393,"sourceId":"0094:000393","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「……うん、もう好きに頑張り」","english":"“...Fine. Fight it however you want.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000394","line":394,"sourceId":"0094:000394","speakerJa":"","speakerEn":"","japanese":"　投げやり。","english":"She had given up.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000396","line":396,"sourceId":"0094:000396","speakerJa":"葉子","speakerEn":"Youko","japanese":"「ふぁいとーおー」","english":"“You can do it!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000398","line":398,"sourceId":"0094:000398","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「おー」","english":"“Yeah!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000400","line":400,"sourceId":"0094:000400","speakerJa":"葉子","speakerEn":"Youko","japanese":"「おー」","english":"“Yeah!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000402","line":402,"sourceId":"0094:000402","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「おー」","english":"“Yeah!”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000404","line":404,"sourceId":"0094:000404","speakerJa":"沙也加","speakerEn":"Sayaka","japanese":"「……あと、\n　殿方には悟られないようにするのが礼儀よ」","english":"“...And another thing. It is only proper to keep gentlemen from noticing.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000406","line":406,"sourceId":"0094:000406","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「うー」","english":"“Uhh.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000408","line":408,"sourceId":"0094:000408","speakerJa":"葉子","speakerEn":"Youko","japanese":"「まあ、わかっちゃいますけどね」","english":"“Well, they can tell anyway.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000410","line":410,"sourceId":"0094:000410","speakerJa":"笛子","speakerEn":"Fueko","japanese":"「……そこはね、もうどうしようもないというか。\n　こそこそしすぎてもアレだし。\n　堂々としても問題ありだし。玉虫色で頑張り」","english":"“...There's only so much you can do about that. Being too furtive about it is awkward. But being brazen is a problem too. Just split the difference as best you can.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000412","line":412,"sourceId":"0094:000412","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「はーい」","english":"“Okay.”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000413","line":413,"sourceId":"0094:000413","speakerJa":"","speakerEn":"","japanese":"　何はともあれ、美景進呈、無事完了。","english":"At any rate, the charming presentation was complete, without a hitch.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000419","line":419,"sourceId":"0094:000419","speakerJa":"","speakerEn":"","japanese":"　とはいえ……生活習慣というものはなかなか切り\n替えが難しい。","english":"That said... habits are not easily changed.","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000420","line":420,"sourceId":"0094:000420","speakerJa":"あずさ","speakerEn":"Azusa","japanese":"「むー、めどい……」","english":"“Ugh, too much work...”","hyperlinks":[],"japaneseHyperlinks":[]},{"ref":"saihate:hyperlinks:0094:000421","line":421,"sourceId":"0094:000421","speakerJa":"","speakerEn":"","japanese":"　訪れるたびに、しみじみとそう思うあずさであっ\nた―――","english":"Every time it came around, Azusa found herself thinking the same thing all over again—","hyperlinks":[],"japaneseHyperlinks":[]}]}