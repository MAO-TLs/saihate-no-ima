    {
      "ref": "saihate:hyperlinks:0063:000106",
      "line": 106,
      "sourceId": "0063:000106",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（人と接することは、戦争みたいなんだ―――）",
      "english": "(Being around people is like war—)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000107",
      "line": 107,
      "sourceId": "0063:000107",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（けど、倒しちゃいけない）",
      "english": "(But you can't defeat the other person.)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000108",
      "line": 108,
      "sourceId": "0063:000108",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（致命傷を与えてはいけないんだ）",
      "english": "(You can't deal them a fatal wound.)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000109",
      "line": 109,
      "sourceId": "0063:000109",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（なんて、難しい……）",
      "english": "(It's so hard...)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000110",
      "line": 110,
      "sourceId": "0063:000110",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　友達作りは意識すれば難しい。",
      "english": "Making friends became difficult the moment one tried to do it consciously.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000111",
      "line": 111,
      "sourceId": "0063:000111",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　セオリーのなさ。\n　加減の困難さ。\n　鉄則の曖昧さ。",
      "english": "No established doctrine. No easy measure of force. No clear rules of engagement.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000112",
      "line": 112,
      "sourceId": "0063:000112",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　遠い道のり―――",
      "english": "A long road ahead—",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000113",
      "line": 113,
      "sourceId": "0063:000113",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「……あってる、と思う」",
      "english": "“...I think that's right.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000114",
      "line": 114,
      "sourceId": "0063:000114",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　認めてしまった。",
      "english": "He had admitted it.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000116",
      "line": 116,
      "sourceId": "0063:000116",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「そう、なんだ」",
      "english": "“I see.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000117",
      "line": 117,
      "sourceId": "0063:000117",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　もうあずさは、臆してはいない。\n　あと一撃で忍は壊れる。\n　自覚があった。",
      "english": "Azusa was no longer intimidated. One more blow would shatter Shinobu. He knew it.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000118",
      "line": 118,
      "sourceId": "0063:000118",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　助けた。そこまではいい。",
      "english": "He had saved her. That much was all right.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000119",
      "line": 119,
      "sourceId": "0063:000119",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　けどその先に踏み込まれたら……貴宮忍防衛線は\nあっけなく瓦解し、敗走の憂き目。",
      "english": "But if she pushed beyond that... Shinobu Atemiya's line of defense would collapse with ridiculous ease, and he would be routed.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000120",
      "line": 120,
      "sourceId": "0063:000120",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　どんな惨めな自分が残るのか、想像もつかない。",
      "english": "He could not imagine what pitiful version of himself would remain.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000122",
      "line": 122,
      "sourceId": "0063:000122",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「貴宮くんは、どうしてあたしを―――」",
      "english": "“Atemiya, why did you—”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000123",
      "line": 123,
      "sourceId": "0063:000123",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　悲鳴をあげそうになった。",
      "english": "He almost screamed.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000124",
      "line": 124,
      "sourceId": "0063:000124",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（…………どうしてって……）",
      "english": "(............Why...)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000125",
      "line": 125,
      "sourceId": "0063:000125",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（どうしてなんだろうな……さて……）",
      "english": "(Why did I...? Now there's a question...)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000126",
      "line": 126,
      "sourceId": "0063:000126",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　いくつかの候補を検討し、絞り込んだ。\n　機械的な過程を経て、出てきたのは意識にのぼる\nこともなかった選択肢。",
      "english": "He considered several possibilities and narrowed them down. A mechanical process produced an answer that had never once risen into his conscious mind.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000127",
      "line": 127,
      "sourceId": "0063:000127",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「友達が、欲しいんだ」",
      "english": "“I want a friend.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000129",
      "line": 129,
      "sourceId": "0063:000129",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　奇跡のように出現したセリフ。\n　あずさの瞳が開かれる。",
      "english": "The words appeared as if by miracle. Azusa's eyes widened.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000130",
      "line": 130,
      "sourceId": "0063:000130",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「どうすればいい？」",
      "english": "“What do I do?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000132",
      "line": 132,
      "sourceId": "0063:000132",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「どうすればって……そんなの……」",
      "english": "“What do you mean, what do you do...? Well...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000133",
      "line": 133,
      "sourceId": "0063:000133",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　戸惑い。",
      "english": "Bewilderment.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000134",
      "line": 134,
      "sourceId": "0063:000134",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「僕、慣れていないんだ。人付き合い」",
      "english": "“I'm not used to being around people.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000135",
      "line": 135,
      "sourceId": "0063:000135",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「だから、よくわからないんだ」",
      "english": "“So I don't really know.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000136",
      "line": 136,
      "sourceId": "0063:000136",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あたしにもわかんないよ、いないし……」",
      "english": "“I don't know either. I don't have any friends...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000137",
      "line": 137,
      "sourceId": "0063:000137",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「そう」",
      "english": "“I see.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000138",
      "line": 138,
      "sourceId": "0063:000138",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「ごめん」",
      "english": "“Sorry.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000144",
      "line": 144,
      "sourceId": "0063:000144",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　立ち去る。",
      "english": "He walked away.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000145",
      "line": 145,
      "sourceId": "0063:000145",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あ、ちょっと！　ちょっと待ってってばっ！？」",
      "english": "“H-hey! Wait a second—I said wait!?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000148",
      "line": 148,
      "sourceId": "0063:000148",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　腕を捕まれた。",
      "english": "She caught hold of his arm.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000149",
      "line": 149,
      "sourceId": "0063:000149",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「…………」",
      "english": "“............”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000150",
      "line": 150,
      "sourceId": "0063:000150",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　捕まれた部分を、忍はじっと見た。",
      "english": "Shinobu stared at the place where she'd grabbed him.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000151",
      "line": 151,
      "sourceId": "0063:000151",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（これは……接触）",
      "english": "(This is... contact.)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000152",
      "line": 152,
      "sourceId": "0063:000152",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（接触されているんだ……\n　だけど、どこか他人事のような……気がする）",
      "english": "(I'm being touched... But somehow... it feels as though it's happening to someone else.)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000159",
      "line": 159,
      "sourceId": "0063:000159",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「知ってる、知ってるよ！」",
      "english": "“I know! I know what to do!”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000160",
      "line": 160,
      "sourceId": "0063:000160",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「え？」",
      "english": "“What?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000162",
      "line": 162,
      "sourceId": "0063:000162",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「友達、の作り方、知ってる……思いついた」",
      "english": "“I know how to make friends... I just thought of it.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000163",
      "line": 163,
      "sourceId": "0063:000163",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　ためらいがちに。",
      "english": "She spoke hesitantly.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000164",
      "line": 164,
      "sourceId": "0063:000164",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「教えて、くれる？」",
      "english": "“Will you tell me?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000166",
      "line": 166,
      "sourceId": "0063:000166",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　あずさは頷く。\n　伏せたまま、顔を持ち上げない。",
      "english": "Azusa nodded. She kept her face lowered and did not look up.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000171",
      "line": 171,
      "sourceId": "0063:000171",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　夕日で顔色もわからないが、それで完全に表情を\nうかがうことができなくなった。",
      "english": "The sunset already hid the color of her face; now he could no longer make out her expression at all.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000172",
      "line": 172,
      "sourceId": "0063:000172",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あたしたちが、友達になれば、いいと思うよ」",
      "english": "“I think we should be friends.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    }
  ]
}
