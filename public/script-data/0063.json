      "line": 59,
      "sourceId": "0063:000059",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あ、あの、待って！」",
      "english": "“W-wait!”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000060",
      "line": 60,
      "sourceId": "0063:000060",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「……なに？」",
      "english": "“...What?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
