      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000019",
      "line": 19,
      "sourceId": "0063:000019",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「…………」",
      "english": "“............”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000020",
      "line": 20,
      "sourceId": "0063:000020",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　今日は立っていた。\n　衣服も着ているし、怪我もない。\n　少年たちもいない。",
      "english": "Today, she was on her feet. She was dressed, and she was unhurt. The boys were nowhere to be seen.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000022",
      "line": 22,
      "sourceId": "0063:000022",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あ、あのさっ」",
      "english": "“H-hey...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000023",
      "line": 23,
      "sourceId": "0063:000023",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　焦って繰り出した彼女の言葉は、唐突なものとなる。",
      "english": "In her rush, the words came out without preamble.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000024",
      "line": 24,
      "sourceId": "0063:000024",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　忍は足を止め、観察するようにあずさを見た。",
      "english": "Shinobu stopped and looked at Azusa as if assessing her.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000025",
      "line": 25,
      "sourceId": "0063:000025",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「なに？」",
      "english": "“What?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000027",
      "line": 27,
      "sourceId": "0063:000027",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「おまえって……そこの」",
      "english": "“You... that place—”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000032",
      "line": 32,
      "sourceId": "0063:000032",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　建物を指さす。",
      "english": "She pointed at the building.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000033",
      "line": 33,
      "sourceId": "0063:000033",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「施設？」",
      "english": "“The facility?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000039",
      "line": 39,
      "sourceId": "0063:000039",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「う、うん……行ってるんだ？」",
      "english": "“Y-yeah... You go there?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000040",
      "line": 40,
      "sourceId": "0063:000040",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「言えないんだ、それ」",
      "english": "“I can't tell you that.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000042",
      "line": 42,
      "sourceId": "0063:000042",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「……え……？」",
      "english": "“...Huh...?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0063:000043",
      "line": 43,
      "sourceId": "0063:000043",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「だからこっちの方から歩いてる」",
      "english": "“That’s why I come this way.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
