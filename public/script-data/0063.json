      "line": 71,
      "sourceId": "0063:000071",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　抑圧されて今のような形になっている。",
      "english": "She had been suppressed until this was what she'd become.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
