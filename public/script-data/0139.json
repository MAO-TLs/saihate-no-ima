{
  "route": "hyperlinks",
  "routeLabel": "Hyperlink entries",
  "scriptId": "0139",
  "lineCount": 54,
  "lines": [
    {
      "ref": "saihate:hyperlinks:0139:000010",
      "line": 10,
      "sourceId": "0139:000010",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「……おまえは罪深い」",
      "english": "“…Your sins run deep.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000011",
      "line": 11,
      "sourceId": "0139:000011",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「ええ……」",
      "english": "“Yes…”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000020",
      "line": 20,
      "sourceId": "0139:000020",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「我々はずっと、おまえの存在を追いかけてきた」",
      "english": "“We have been pursuing you—your very existence—for a long time.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000021",
      "line": 21,
      "sourceId": "0139:000021",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「ずっと？」",
      "english": "“A long time?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000023",
      "line": 23,
      "sourceId": "0139:000023",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「正確には、おまえの存在を予見していた」",
      "english": "“To be precise, we foresaw that you would exist.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000024",
      "line": 24,
      "sourceId": "0139:000024",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「どのようにです？」",
      "english": "“How?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000026",
      "line": 26,
      "sourceId": "0139:000026",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「人間真理に基づいてだ」",
      "english": "“Through the truth of human nature.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000027",
      "line": 27,
      "sourceId": "0139:000027",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「わかる気がします」",
      "english": "“I think I see.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000029",
      "line": 29,
      "sourceId": "0139:000029",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「隠蔽は無数に施されていた。\n　現実でも、それ以外でも」",
      "english": "“There were countless layers of concealment. In reality and elsewhere.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000031",
      "line": 31,
      "sourceId": "0139:000031",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「巧妙に偽装された要素の数々は、個別に見れば\n　自然ではあるが、集合すれば違和感がある」",
      "english": "“Each cleverly disguised element looks natural in isolation. Taken together, however, they feel wrong.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000033",
      "line": 33,
      "sourceId": "0139:000033",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「確たる証拠もなく、ただ疑念だけが浮かび上がる\n　のであれば……人の視線は集中力を持って向けら\n　れるものだ」",
      "english": "“When there is no firm evidence and only suspicion emerges… the human gaze turns on its object with exceptional focus.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000034",
      "line": 34,
      "sourceId": "0139:000034",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「だけど……納得できないんです」",
      "english": "“But… something still doesn't make sense to me.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000036",
      "line": 36,
      "sourceId": "0139:000036",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「ほう？」",
      "english": "“Oh?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000037",
      "line": 37,
      "sourceId": "0139:000037",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「ならどうして、僕は泳がされていたんですか？」",
      "english": "“Then why did you let me run free?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000039",
      "line": 39,
      "sourceId": "0139:000039",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「おまえは森に隠された木の葉だ。\n　発見は容易ではない」",
      "english": "“You were a leaf hidden in a forest. Finding you was no easy matter.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000040",
      "line": 40,
      "sourceId": "0139:000040",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「……だけど、ついにはこうして捕まった」",
      "english": "“…And yet you finally caught me.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000042",
      "line": 42,
      "sourceId": "0139:000042",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「罪人は捕らえられる。絞首刑にかけられるために」",
      "english": "“Sinners are caught so that they may be hanged.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000043",
      "line": 43,
      "sourceId": "0139:000043",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「章二は聖域って言ってたんです。僕はそれを守り\n　たかっただけだ」",
      "english": "“Shouji called it a sanctuary. All I wanted was to protect it.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000045",
      "line": 45,
      "sourceId": "0139:000045",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「そのために、他者の聖域を侵害してか？」",
      "english": "“Even if protecting it meant violating other people's sanctuaries?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000046",
      "line": 46,
      "sourceId": "0139:000046",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「そこが……僕のアキレス腱だったんだと思います。\n　ずっと」",
      "english": "“I think that was… my Achilles' heel. All along.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000047",
      "line": 47,
      "sourceId": "0139:000047",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「薄汚い綺麗事だと、あなたは言うのでしょうね」",
      "english": "“You would call it a dirty little piece of idealism, I suppose.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000049",
      "line": 49,
      "sourceId": "0139:000049",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「誰だって良い子でいたいものだ、背負う罪は軽い\n　方がいい」",
      "english": "“Everyone wants to be good. The less sin one has to carry, the better.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000050",
      "line": 50,
      "sourceId": "0139:000050",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「だけど大人のやり方は……\n　何も生み出さないですよ」",
      "english": "“But the way adults do things… never creates anything.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000052",
      "line": 52,
      "sourceId": "0139:000052",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「抵抗があったからだ。\n　円滑に進めば、うまくいった」",
      "english": "“There was resistance. Had the process gone smoothly, it would have worked.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000053",
      "line": 53,
      "sourceId": "0139:000053",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「誰も彼もが、自らの意志を持ち、行動する」",
      "english": "“Every person has a will of their own, and acts upon it.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000054",
      "line": 54,
      "sourceId": "0139:000054",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「あなただって」",
      "english": "“You do too.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000056",
      "line": 56,
      "sourceId": "0139:000056",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「私は意志など振りかざしたことはない」",
      "english": "“I have never brandished a will of my own.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000057",
      "line": 57,
      "sourceId": "0139:000057",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「より上位の指揮系統に従属する。それが適切だと\n　考え、実行していただけだ」",
      "english": "“I subordinate myself to a higher chain of command. I judged that proper and acted accordingly. Nothing more.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000058",
      "line": 58,
      "sourceId": "0139:000058",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「かくのごとく記録し、実行致します」",
      "english": "“Thus shall I record it and carry it out.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000060",
      "line": 60,
      "sourceId": "0139:000060",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「そういうことだ」",
      "english": "“Precisely.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000071",
      "line": 71,
      "sourceId": "0139:000071",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「私とおまえは正反対だな」",
      "english": "“You and I are exact opposites.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000072",
      "line": 72,
      "sourceId": "0139:000072",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「そして罪は僕の側に」",
      "english": "“And the sin is mine.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000074",
      "line": 74,
      "sourceId": "0139:000074",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「どちらが正しい？」",
      "english": "“Which of us is right?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000075",
      "line": 75,
      "sourceId": "0139:000075",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「わかりません……\n　けど、あなたの方が、正しいんでしょうね」",
      "english": "“I don't know… But I suppose you're the one who's right.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000077",
      "line": 77,
      "sourceId": "0139:000077",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「正しい行為などない。あるのは、人に都合の良い\n　概念だけだ。人は概念によって駆動するのだから」",
      "english": "“There are no right actions. There are only concepts convenient to humankind. Concepts are what drive people.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000078",
      "line": 78,
      "sourceId": "0139:000078",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「その意味では、おまえと私の辿った道は、同じ目\n　的地を目指した同じ距離の往路であり、二つは\n　ただ線対称に弧を描く、同質のものだ」",
      "english": "“In that sense, the paths you and I took are journeys of equal length toward the same destination. Two arcs, mirror images across a line—identical in nature.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000079",
      "line": 79,
      "sourceId": "0139:000079",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「罪を償う気持ちはあります。\n　ただその手段がわからない」",
      "english": "“I want to atone for what I've done. I simply don't know how.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000081",
      "line": 81,
      "sourceId": "0139:000081",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「罪を償うことなどできない。罪は消えない。\n　抹消されない」",
      "english": "“You cannot atone for sin. Sin does not vanish. It cannot be erased.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000082",
      "line": 82,
      "sourceId": "0139:000082",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「そして誰もおまえを裁くことはできない」",
      "english": "“And no one can judge you.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000083",
      "line": 83,
      "sourceId": "0139:000083",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「……そうでしょうか」",
      "english": "“…Do you really think so?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000085",
      "line": 85,
      "sourceId": "0139:000085",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「自分で確かめることだ。薄暗い牢獄の中で」",
      "english": "“Find out for yourself. In a dim prison.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000086",
      "line": 86,
      "sourceId": "0139:000086",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「本当に牢獄ですよ―――そこは。\n　灰色の部屋で、僕は死ぬんだ」",
      "english": "“It really is a prison—that place. I'll die there, in a gray room.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000088",
      "line": 88,
      "sourceId": "0139:000088",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「おまえは死なない」",
      "english": "“You will not die.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000090",
      "line": 90,
      "sourceId": "0139:000090",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "ひとや",
      "english": "prison",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000091",
      "line": 91,
      "sourceId": "0139:000091",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「ただ、獄に繋がれる。それも一時のことだ」",
      "english": "“You will merely be bound in prison—and only for a time.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000092",
      "line": 92,
      "sourceId": "0139:000092",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「おまえを読んで、私はそう解釈した」",
      "english": "“I read you. That is my interpretation.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000093",
      "line": 93,
      "sourceId": "0139:000093",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「……姉さんと同じ能力」",
      "english": "“…The same ability as my sister.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000095",
      "line": 95,
      "sourceId": "0139:000095",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「姉、か……」",
      "english": "“Your sister…”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000096",
      "line": 96,
      "sourceId": "0139:000096",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「わかっていますよ」",
      "english": "“I know.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000098",
      "line": 98,
      "sourceId": "0139:000098",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「ああ」",
      "english": "“Yes.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000099",
      "line": 99,
      "sourceId": "0139:000099",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「でも、あなたの考えていることは、最後までわか\n　りませんでした」",
      "english": "“But to the very end, I never understood what you were thinking.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000101",
      "line": 101,
      "sourceId": "0139:000101",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「何も考えていない」",
      "english": "“I think of nothing.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000102",
      "line": 102,
      "sourceId": "0139:000102",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「何も求めてはいない」",
      "english": "“I seek nothing.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0139:000104",
      "line": 104,
      "sourceId": "0139:000104",
      "speakerJa": "灰野",
      "speakerEn": "Haino",
      "japanese": "「統べること以外には―――何も」",
      "english": "“Nothing—except to rule.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    }
  ]
}
