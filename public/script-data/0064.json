  "lines": [
    {
      "ref": "saihate:hyperlinks:0064:000018",
      "line": 18,
      "sourceId": "0064:000018",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　あずさと遭遇。\n　少年たちはいない。",
      "english": "Encountered Azusa. The boys were absent.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000019",
      "line": 19,
      "sourceId": "0064:000019",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　いじめで連れ込まれたわけではないようだ。\n　自らの意志で来たということか。",
      "english": "Apparently, she had not been dragged here to be bullied. Then she must have come of her own accord.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000021",
      "line": 21,
      "sourceId": "0064:000021",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あ、あのさっ」",
      "english": "“H-hey...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000022",
      "line": 22,
      "sourceId": "0064:000022",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　焦って繰り出した彼女の言葉は、唐突なものとなる。",
      "english": "In her rush, the words came out without preamble.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000023",
      "line": 23,
      "sourceId": "0064:000023",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　忍は足を止め、観察するようにあずさを見た。",
      "english": "Shinobu stopped and looked at Azusa as if assessing her.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000024",
      "line": 24,
      "sourceId": "0064:000024",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「なに？」",
      "english": "“What?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000026",
      "line": 26,
      "sourceId": "0064:000026",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「おまえって……そこの」",
      "english": "“You... that place—”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000027",
      "line": 27,
      "sourceId": "0064:000027",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　建物を指さす。",
      "english": "She pointed at the building.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000032",
      "line": 32,
      "sourceId": "0064:000032",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「施設？」",
      "english": "“The facility?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000038",
      "line": 38,
      "sourceId": "0064:000038",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「う、うん……行ってるんだ？」",
      "english": "“Y-yeah... You go there?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000039",
      "line": 39,
      "sourceId": "0064:000039",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「言えないんだ、それ」",
      "english": "“I can't tell you that.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000041",
      "line": 41,
      "sourceId": "0064:000041",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「……え……？」",
      "english": "“...Huh...?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000042",
      "line": 42,
      "sourceId": "0064:000042",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「だからこっちの方から歩いてる」",
      "english": "“That’s why I come this way.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000043",
      "line": 43,
      "sourceId": "0064:000043",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「人にあまり見られないように」",
      "english": "“So people won't see me.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000044",
      "line": 44,
      "sourceId": "0064:000044",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　あずさは竦んだようになった。\n　黙って様子を見ていた。",
      "english": "Azusa drew into herself. He watched her in silence.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000045",
      "line": 45,
      "sourceId": "0064:000045",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　が、いくら待ってもあずさが取り繕うことはなさ\nそうだった。",
      "english": "But however long he waited, Azusa showed no sign of recovering her composure.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000046",
      "line": 46,
      "sourceId": "0064:000046",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　だから自ら状況を動かした。",
      "english": "So he took it upon himself to move things along.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000051",
      "line": 51,
      "sourceId": "0064:000051",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「人に、言う？」",
      "english": "“Will you tell anyone?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000053",
      "line": 53,
      "sourceId": "0064:000053",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　あずさは首を振る。",
      "english": "Azusa shook her head.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000054",
      "line": 54,
      "sourceId": "0064:000054",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「ならいい」",
      "english": "“Then it's fine.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000058",
      "line": 58,
      "sourceId": "0064:000058",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　歩き出す。",
      "english": "He began to walk.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000059",
      "line": 59,
      "sourceId": "0064:000059",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あ、あの、待って！」",
      "english": "“W-wait!”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000060",
      "line": 60,
      "sourceId": "0064:000060",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「……なに？」",
      "english": "“...What?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000065",
      "line": 65,
      "sourceId": "0064:000065",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「こないだの、こと」",
      "english": "“About the other day.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000067",
      "line": 67,
      "sourceId": "0064:000067",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　あずさ、赤面してうつむく。",
      "english": "Azusa blushed and bowed her head.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000068",
      "line": 68,
      "sourceId": "0064:000068",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「ええと」",
      "english": "“Um.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000070",
      "line": 70,
      "sourceId": "0064:000070",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「う、うん。なに？」",
      "english": "“Y-yeah? What about it?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000072",
      "line": 72,
      "sourceId": "0064:000072",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「このあいだのことは……なに？」",
      "english": "“What about the other day?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000073",
      "line": 73,
      "sourceId": "0064:000073",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「このあいだのことは、」",
      "english": "“About the other day...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000074",
      "line": 74,
      "sourceId": "0064:000074",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　少し考え、",
      "english": "He paused to think, then—",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000075",
      "line": 75,
      "sourceId": "0064:000075",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「気にしないでいいから」",
      "english": "“You don't need to worry about it.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000077",
      "line": 77,
      "sourceId": "0064:000077",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あれって」",
      "english": "“That time...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000078",
      "line": 78,
      "sourceId": "0064:000078",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「助けてもらった？」",
      "english": "“Did you save me?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000079",
      "line": 79,
      "sourceId": "0064:000079",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　面と向かって言われ、忍も少し戸惑う。\n　あずさの態度が、柔らかいことに。",
      "english": "The direct question gave Shinobu pause. So did the softness of Azusa's manner.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000080",
      "line": 80,
      "sourceId": "0064:000080",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「たぶん……」",
      "english": "“I think so...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000082",
      "line": 82,
      "sourceId": "0064:000082",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「どうして」",
      "english": "“Why...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000083",
      "line": 83,
      "sourceId": "0064:000083",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「―――たすけた？」",
      "english": "“—did you save me?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000084",
      "line": 84,
      "sourceId": "0064:000084",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「…………」",
      "english": "“............”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000085",
      "line": 85,
      "sourceId": "0064:000085",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　回答不能。",
      "english": "Answer: impossible.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000087",
      "line": 87,
      "sourceId": "0064:000087",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「貴宮君はあたしを助けた―――あってる？」",
      "english": "“You saved me—is that right, Atemiya?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000088",
      "line": 88,
      "sourceId": "0064:000088",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　回答可能。",
      "english": "Answer: possible.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000089",
      "line": 89,
      "sourceId": "0064:000089",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　言語化してしまうと、少女あずさとの距離が変化\nしてしまういそうな気がした。",
      "english": "He felt that putting it into words might alter the distance between himself and the girl, Azusa.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000090",
      "line": 90,
      "sourceId": "0064:000090",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　これ以上の接近は無意味。\n　思考はそう告げていた。",
      "english": "Further approach served no purpose. That was the conclusion his mind returned.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000091",
      "line": 91,
      "sourceId": "0064:000091",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　そもそも助けたこと自体が誤りだったと今は思う。\n　放置すべきだった。",
      "english": "Now he thought that rescuing her at all had been a mistake. He should have left her alone.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000092",
      "line": 92,
      "sourceId": "0064:000092",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　忍がコースを変えれば良かった。\n　失敗だ。",
      "english": "Shinobu should have taken a different route. Failure.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000094",
      "line": 94,
      "sourceId": "0064:000094",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　だいぶ印象づけられたのだろうなと思う。\n　あずさは忍が施設通いをしていることを忘れない\nだろう。",
      "english": "He thought he must have made quite an impression on her. Azusa would not forget that Shinobu went to the facility.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000095",
      "line": 95,
      "sourceId": "0064:000095",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　ならばある程度、監視下に置いておくという手も\nある。",
      "english": "One option, then, was to keep her under a limited degree of observation.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000096",
      "line": 96,
      "sourceId": "0064:000096",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　そう……もう忍とあずさは無関係ではないのだ。\n　下手な対応はできない。",
      "english": "Yes... A connection now existed between Shinobu and Azusa. He could not afford to handle this poorly.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000097",
      "line": 97,
      "sourceId": "0064:000097",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　慎重に、口を開いた。",
      "english": "He chose his words carefully.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000099",
      "line": 99,
      "sourceId": "0064:000099",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「……あってる、と思う」",
      "english": "“...I think that's right.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000100",
      "line": 100,
      "sourceId": "0064:000100",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　あずさの態度が目に見えて軟化している。\n　流れは止まらないだろう。",
      "english": "Azusa’s manner was softening before his eyes. This would probably keep going.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000101",
      "line": 101,
      "sourceId": "0064:000101",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　あずさは忍に感染・発症している。\n　侵略してしまったのだ。",
      "english": "Azusa had become infected with Shinobu. The symptoms had manifested. He had invaded her.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000102",
      "line": 102,
      "sourceId": "0064:000102",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　もう退けない。",
      "english": "Too late to retreat.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000104",
      "line": 104,
      "sourceId": "0064:000104",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「そう、なんだ」",
      "english": "“I see.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000106",
      "line": 106,
      "sourceId": "0064:000106",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「貴宮くんは、どうしてあたしを―――」",
      "english": "“Atemiya, why did you—”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000107",
      "line": 107,
      "sourceId": "0064:000107",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "（１／問題になると思った）（２／命令された）\n（３／助けない方が不自然だと思った）\n（４／助けたかった）",
      "english": "(1 / I thought it might cause a problem.)\n(2 / I was ordered to.)\n(3 / I thought not helping would look unnatural.)\n(4 / I wanted to help.)",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000108",
      "line": 108,
      "sourceId": "0064:000108",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　いくつかの候補を検討し、絞り込んだ。",
      "english": "He considered several possibilities and narrowed them down.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000109",
      "line": 109,
      "sourceId": "0064:000109",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「友達が、欲しいんだ」",
      "english": "“I want a friend.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000110",
      "line": 110,
      "sourceId": "0064:000110",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　告げる忍の表情に、感情的な変化はない。\n　が、友人のいないあずさは、そんな機微さえ読み\n取れない。",
      "english": "Shinobu's expression showed no emotional change as he said it. But Azusa, who had no friends herself, could not read even that nuance.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000111",
      "line": 111,
      "sourceId": "0064:000111",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「どうすればいい？」",
      "english": "“What do I do?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000113",
      "line": 113,
      "sourceId": "0064:000113",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「どうすればって……そんなの……」",
      "english": "“What do you mean, what do you do...? Well...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000114",
      "line": 114,
      "sourceId": "0064:000114",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「僕、慣れていないんだ。人付き合い」",
      "english": "“I'm not used to being around people.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000115",
      "line": 115,
      "sourceId": "0064:000115",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　感情の欠落に、あずさは気付かない。",
      "english": "Azusa did not notice the absence of emotion.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000116",
      "line": 116,
      "sourceId": "0064:000116",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「だから、よくわからないんだ」",
      "english": "“So I don't really know.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000117",
      "line": 117,
      "sourceId": "0064:000117",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あたしにもわかんないよ、いないし……」",
      "english": "“I don't know either. I don't have any friends...”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000118",
      "line": 118,
      "sourceId": "0064:000118",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「そう」",
      "english": "“I see.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000119",
      "line": 119,
      "sourceId": "0064:000119",
      "speakerJa": "忍",
      "speakerEn": "Shinobu",
      "japanese": "「ごめん」",
      "english": "“Sorry.”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000123",
      "line": 123,
      "sourceId": "0064:000123",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "立ち去ろうとする。",
      "english": "He turned to leave.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000124",
      "line": 124,
      "sourceId": "0064:000124",
      "speakerJa": "あずさ",
      "speakerEn": "Azusa",
      "japanese": "「あ、ちょっと！　ちょっと待ってってばっ！？」",
      "english": "“H-hey! Wait a second—I said wait!?”",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000127",
      "line": 127,
      "sourceId": "0064:000127",
      "speakerJa": "",
      "speakerEn": "",
      "japanese": "　腕を捕まれた。",
      "english": "She caught hold of his arm.",
      "hyperlinks": [],
      "japaneseHyperlinks": []
    },
    {
      "ref": "saihate:hyperlinks:0064:000128",
